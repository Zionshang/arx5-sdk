# Use Ubuntu 22.04
FROM ubuntu:22.04

# Avoid prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git \
    curl \
    wget \
    build-essential \
    cmake \
    libusb-1.0-0-dev \
    libudev-dev \
    can-utils \
    kmod \
    sudo \
    udev \
    nano \
    && rm -rf /var/lib/apt/lists/*

# Install Miniforge (Mamba)
RUN curl -L -O "https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-$(uname)-$(uname -m).sh" \
    && bash Miniforge3-$(uname)-$(uname -m).sh -b -p /opt/conda \
    && rm Miniforge3-$(uname)-$(uname -m).sh

# Add conda to path
ENV PATH=/opt/conda/bin:$PATH

# Set working directory
WORKDIR /app

# Copy environment file
COPY conda_environments/py310_environment.yaml /app/conda_environments/

# Create environment (SOEM is included in the yaml for x86)
RUN mamba env create -f /app/conda_environments/py310_environment.yaml && \
    mamba clean --all -f -y

# Set default shell
SHELL ["conda", "run", "-n", "arx-py310", "/bin/bash", "-c"]

# Copy the rest of the project
COPY . /app

# Build the Python C++ Extension
RUN cd python && \
    mkdir -p build && \
    cd build && \
    cmake .. && \
    make -j$(nproc) && \
    # Move the compiled shared object to python/ directory
    find . -name "arx5_interface.cpython-*.so" -exec cp {} ../ \;

# Install the joystick package
RUN pip install pygame

# Setup environment variables needed at runtime
# Using x86_64 library path
ENV LD_LIBRARY_PATH=/app/lib/x86_64:$LD_LIBRARY_PATH
ENV PYTHONPATH=/app/python:$PYTHONPATH

# Default command
ENTRYPOINT ["conda", "run", "--no-capture-output", "-n", "arx-py310"]
CMD ["/bin/bash"]
